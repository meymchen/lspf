[
  {
    "label": "build lspf-markdown",
    "command": "cargo",
    "args": ["build", "-p", "lspf-markdown"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "test lspf-markdown (quick)",
    "command": "cargo",
    "args": ["test", "-p", "lspf-markdown"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "test workspace (full)",
    "command": "cargo",
    "args": ["test-native"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "run hover example (waits for stdio client)",
    "command": "cargo",
    "args": ["run", "-p", "lspf", "--example", "hover"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
