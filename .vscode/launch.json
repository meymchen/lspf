{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug LSP client (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-test-client"
      ],
      "outFiles": [
        "${workspaceFolder}/tools/vscode-test-client/out/**/*.js"
      ],
      "preLaunchTask": "prepare VS Code reference server"
    },
    {
      "name": "Debug LSP client connected to lspf-markdown over TCP",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-test-client",
        "${workspaceFolder}/editor-validation/fixture"
      ],
      "env": {
        "LSPF_TEST_CONNECT": "127.0.0.1:9259"
      },
      "outFiles": [
        "${workspaceFolder}/tools/vscode-test-client/out/**/*.js"
      ],
      "preLaunchTask": "prepare VS Code test client",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Debug lspf-markdown server over TCP (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/lspf-markdown.exe",
      "args": ["--listen", "127.0.0.1:9259"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "build lspf-markdown"
    },
    {
      "name": "Debug lspf-markdown server over TCP (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/lspf-markdown",
      "windows": {
        "program": "${workspaceFolder}/target/debug/lspf-markdown.exe"
      },
      "args": ["--listen", "127.0.0.1:9259"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build lspf-markdown"
    },
    {
      "name": "Run LSP example client (select example)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-test-client"
      ],
      "env": {
        "LSPF_TEST_EXAMPLE": "${input:exampleName}"
      },
      "outFiles": [
        "${workspaceFolder}/tools/vscode-test-client/out/**/*.js"
      ],
      "preLaunchTask": "prepare VS Code LSP example"
    },
    {
      "name": "Run Notebook example client",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-test-client",
        "${workspaceFolder}/crates/lspf/examples/notebooks/demo.ipynb"
      ],
      "env": {
        "LSPF_TEST_EXAMPLE": "notebooks"
      },
      "outFiles": [
        "${workspaceFolder}/tools/vscode-test-client/out/**/*.js"
      ],
      "preLaunchTask": "prepare VS Code LSP example"
    },
    {
      "name": "Run LSP example client over a socket (select transport)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-test-client"
      ],
      "env": {
        "LSPF_TEST_TRANSPORT": "${input:socketTransport}"
      },
      "outFiles": [
        "${workspaceFolder}/tools/vscode-test-client/out/**/*.js"
      ],
      "preLaunchTask": "prepare VS Code LSP socket example"
    },
    {
      "name": "Debug website (Firefox)",
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "tmpDir": "${env:HOME}/snap/firefox/common",
      "url": "http://127.0.0.1:5173/",
      "webRoot": "${workspaceFolder}/website",
      "preLaunchTask": "dev website"
    },
    {
      "name": "Attach to running LSP server/example",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickMyProcess}"
    },
    {
      "name": "Attach to running LSP server/example (Windows)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": [
    {
      "name": "Debug lspf-markdown client + server (Windows)",
      "preLaunchTask": "prepare VS Code reference server",
      "configurations": [
        "Debug lspf-markdown server over TCP (Windows)",
        "Debug LSP client connected to lspf-markdown over TCP"
      ],
      "stopAll": true
    },
    {
      "name": "Debug lspf-markdown client + server (LLDB)",
      "preLaunchTask": "prepare VS Code reference server",
      "configurations": [
        "Debug lspf-markdown server over TCP (LLDB)",
        "Debug LSP client connected to lspf-markdown over TCP"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "socketTransport",
      "type": "pickString",
      "description": "Transport the language client connects over: tcp dials 127.0.0.1:9257, websocket dials 127.0.0.1:9258",
      "default": "tcp",
      "options": ["tcp", "websocket"]
    },
    {
      "id": "exampleName",
      "type": "pickString",
      "description": "Cargo stdio LSP example",
      "default": "hover",
      "options": [
        "hover",
        "code_actions",
        "code_lens",
        "colors",
        "formatting",
        "goto",
        "inlay_hints",
        "links",
        "notebooks",
        "publish_diagnostics",
        "pull_diagnostics",
        "rename",
        "semantic_tokens",
        "server_features",
        "symbols",
        "blocking_work"
      ]
    }
  ]
}
