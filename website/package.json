{
  "name": "lspf-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev --host 127.0.0.1",
    "check": "npm run check:brand && npm run check:i18n",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:built": "node scripts/check-built-site.mjs",
    "build": "vitepress build && npm run check:built",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
