{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  // Keep CLI, editor, and CI behavior in one repository-level configuration.
  "gitignore": true,
  "globs": ["**/*.md"],
  // The changelog is generated by release-plz from commit messages, so linting
  // it would constrain the generator rather than an author.
  "ignores": [
    "CLAUDE.md",
    "docs/adr/**",
    "docs/agents/**",
    "crates/lspf/CHANGELOG.md"
  ],
  "config": {
    "default": true,

    // Prose, tables, badges, and long links are more readable when wrapping is
    // left to authors and renderers. This also matches vscode-markdownlint's
    // default behavior.
    "MD013": false,

    // Reusing a heading under different parent sections is valid documentation
    // structure; duplicates among siblings remain errors.
    "MD024": {
      "siblings_only": true
    },

    // Skill documents (e.g. .agents/skills/**/SKILL.md) carry their title in
    // the front matter `name` field and start the body at `##`; treating both
    // `title` and `name` front matter properties as the document heading keeps
    // the H1 requirement for prose files without imposing it on skills.
    "MD041": {
      "front_matter_title": "^\\s*(title|name)\\s*[:=]"
    }
  }
}
